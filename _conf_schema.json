{
  "comfyui_servers": {
    "description": "ComfyUI 服务器列表",
    "hint": "可添加多个服务器，但同一时间只能启用一个（enabled=true）。绘图时自动选用启用的那一个；若都未启用则使用第一个。点击右上角“添加”新增条目。",
    "type": "template_list",
    "templates": {
      "default": {
        "name": "服务器",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "服务器名称",
            "hint": "自定义标识，用于工作流绑定（server_name 填它）。",
            "default": "server1"
          },
          "url": {
            "type": "string",
            "description": "服务地址",
            "hint": "需包含 http(s)://，例如 http://127.0.0.1:8188",
            "default": "http://127.0.0.1:8188"
          },
          "enabled": {
            "type": "bool",
            "description": "是否启用",
            "hint": "多个服务器只能启用一个，否则绘图会报错。",
            "default": false
          },
          "client_id": {
            "type": "string",
            "description": "客户端 ID（可选）",
            "hint": "用于区分队列中的任务，留空会自动生成。",
            "default": ""
          }
        }
      }
    },
    "default": []
  },
  "loras": {
    "description": "LoRA 库（全局，所有工作流共用）",
    "hint": "在此集中管理每个 LoRA 的真实文件名、是否「仅模型」、关键词与多套提示词预设。工作流里只需用 名称|权重|是否启用 引用即可。点击“添加”新增 LoRA。",
    "type": "template_list",
    "templates": {
      "default": {
        "name": "LoRA",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "LoRA 名称（引用键）",
            "hint": "在工作流与指令里都用这个名字引用，例如 --安魂曲。",
            "default": ""
          },
          "model_name": {
            "type": "string",
            "description": "ComfyUI 文件名（别名）",
            "hint": "工作流 LoraLoader 的 lora_name 实际填这个，例如 anima_lacrimosa.safetensors。",
            "default": ""
          },
          "model_only": {
            "type": "bool",
            "description": "使用「仅模型」节点",
            "hint": "默认开启。开启时只把 LoRA 叠加到去噪网络（MODEL），不需要 CLIP 锚点、兼容性最好；某些需要文本编码器权重的 LoRA（如部分风格 LoRA）若要同时影响 CLIP，请关闭此项。",
            "default": true
          },
          "weight": {
            "type": "float",
            "description": "默认权重",
            "hint": "指令 / 工作流未指定权重时使用。",
            "default": 1.0
          },
          "keywords": {
            "type": "string",
            "description": "触发关键词（可选）",
            "hint": "逗号分隔。用户输入提示词命中这些词时，自动启用该 LoRA（即便工作流默认未启用）。",
            "default": ""
          },
          "presets": {
            "type": "text",
            "description": "提示词预设（可多套）",
            "hint": "每套预设用 [预设名|提示词] 表示，多套之间用空格隔开，例如：[预设1|提示词1] [预设2|solo, 1girl]。提示词里可以包含逗号（中英文均可）。调用方式：/draw 提示词 --名称-预设名。留空则无预设。",
            "default": ""
          }
        }
      }
    },
    "default": []
  },
  "workflows": {
    "description": "工作流列表",
    "hint": "可添加多个工作流，每个工作流绑定一个服务器、配置节点 ID 与 LoRA。点击“添加”新增条目。",
    "type": "template_list",
    "templates": {
      "default": {
        "name": "工作流",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "工作流名称",
            "hint": "指令 /draw --wf 和 AI 调用时引用此名。",
            "default": "default"
          },
          "server_name": {
            "type": "string",
            "description": "绑定服务器",
            "hint": "填上面服务器的 name；只有一个服务器时可留空。",
            "default": ""
          },
          "is_anima": {
            "type": "bool",
            "description": "是否 Anima 工作流",
            "hint": "若为 true，提交前会把中文提示词发到 Danbooru 标签服务器翻译为英文标签。",
            "default": false
          },
          "workflow_name": {
            "type": "string",
            "description": "工作流文件名",
            "hint": "插件数据目录 workflow/ 下的文件名（如 sd.json 或 sd）；只需填名字，不用写全路径，缺 .json 会自动补。也可改用最下方文本框直接粘贴 JSON。",
            "default": ""
          },
          "positive_node": {
            "type": "string",
            "description": "正向提示词节点 ID",
            "hint": "在导出的 JSON 里找 class_type 为 CLIPTextEncode 的正向提示词节点，把它的键名（如 6）填这里。正向下输入框名固定为 text，无需填写。",
            "obvious_hint": true,
            "default": ""
          },
          "negative_node": {
            "type": "string",
            "description": "负向提示词节点 ID",
            "hint": "负向 CLIPTextEncode 节点的键名（如 7）。负向下输入框名固定为 text，无需填写。",
            "obvious_hint": true,
            "default": ""
          },
          "resolution_node": {
            "type": "string",
            "description": "宽高节点 ID",
            "hint": "Empty Latent Image / 控制分辨率的节点键名（如 5）。宽和高属于同一节点，只需填这一个 ID。留空则自动查找工作流里的 EmptyLatentImage 节点。",
            "obvious_hint": true,
            "default": ""
          },
          "resolution_width_field": {
            "type": "string",
            "description": "宽度输入框名",
            "hint": "宽高节点里控制宽度的输入框名称，一般是 width。",
            "default": "width"
          },
          "resolution_height_field": {
            "type": "string",
            "description": "高度输入框名",
            "hint": "宽高节点里控制高度的输入框名称，一般是 height。",
            "default": "height"
          },
          "output_node": {
            "type": "string",
            "description": "输出节点 ID（可选）",
            "hint": "SaveImage / PreviewImage 节点的键名；留空则自动取最后一个含 images 输出的节点。",
            "default": ""
          },
          "default_width": {
            "type": "int",
            "description": "默认宽度",
            "hint": "指令 / AI 未指定 --w 时使用。",
            "slider": {
              "min": 64,
              "max": 2048,
              "step": 64
            },
            "default": 512
          },
          "default_height": {
            "type": "int",
            "description": "默认高度",
            "hint": "指令 / AI 未指定 --h 时使用。",
            "slider": {
              "min": 64,
              "max": 2048,
              "step": 64
            },
            "default": 512
          },
          "lora_anchor": {
            "type": "string",
            "description": "主模节点 ID（可选）",
            "hint": "工作流本身没有 LoraLoader 节点、想完全靠下方配置组装 LoRA 时填写：填主模加载节点（CheckpointLoader / UNETLoader）的键名（示例：4，仅举例、非默认值）。插件会在它之后自动新建 LoRA 节点并接线；留空则自动探测主模节点。若工作流已有 LoraLoader 则无需填写。默认「加载LoRA（仅模型）」只需这一路主模锚点即可。",
            "default": ""
          },
          "lora_clip": {
            "type": "string",
            "description": "主模 CLIP 节点 ID（可选，仅完整模式用）",
            "hint": "使用完整 LoraLoader（即该 LoRA 在全局库里关闭「仅模型」，同时影响 model+CLIP）时，若自动探测不到或接错 CLIP 源，在此显式填写 CLIP 模型节点的键名（示例：6，仅举例）。留空则自动探测。配合上方主模节点可分别指定 model 源与 clip 源，兼容「正向/负向提示词用不同 CLIPLoader」等工作流。仅模型模式不需要此项。",
            "default": ""
          },
          "loras_text": {
            "type": "text",
            "description": "LoRA 默认启用列表（每行一个，可选）",
            "hint": "每行一个 LoRA，用竖线 | 分隔三个字段：名称|权重|0/1（0=禁用，1=启用）。例如：安魂曲|1.0|1  可写多行，作用相当于本工作流的“默认启用/权重”。LoRA 的真实文件名、是否仅模型、预设提示词都在上方全局「LoRA 库」里配置，这里只需用名称引用即可；留空则本工作流不默认启用任何 LoRA（仍可用 /draw --名称 临时启用）。即使写了，若标记为 0（禁用）也不会生效。",
            "default": ""
          },
          "workflow_json": {
            "type": "text",
            "description": "直接粘贴 JSON（备选）",
            "hint": "把 ComfyUI 里导出的 API 格式工作流 JSON 粘到这里（与 workflow_name 二选一）。放在最下方避免影响上方字段。",
            "default": ""
          }
        }
      }
    },
    "default": []
  },
  "default_workflow": {
    "type": "string",
    "description": "默认工作流名",
    "hint": "留空则用第一个工作流。",
    "default": ""
  },
  "danbooru": {
    "type": "object",
    "description": "Danbooru 标签服务器",
    "hint": "用于 Anima 工作流翻译中文提示词。只需在用到 Anima 工作流时配置并启用。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用翻译",
        "default": false
      },
      "url": {
        "type": "string",
        "description": "标签服务器地址",
        "hint": "例如 http://127.0.0.1:11111",
        "default": "http://127.0.0.1:11111"
      },
      "api_path": {
        "type": "string",
        "description": "搜索接口路径",
        "default": "/api/search"
      },
      "limit": {
        "type": "int",
        "description": "标签数量上限",
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        },
        "default": 20
      },
      "show_nsfw": {
        "type": "bool",
        "description": "包含 NSFW 标签",
        "default": false
      },
      "use_segmentation": {
        "type": "bool",
        "description": "启用分词",
        "default": true
      },
      "popularity": {
        "type": "float",
        "description": "标签流行度阈值",
        "hint": "仅返回流行度不低于该值的标签（0~1），值越高过滤掉的生僻标签越多。",
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.05
        },
        "default": 0.15
      },
      "top_k": {
        "type": "int",
        "description": "候选标签数量(top_k)",
        "hint": "接口返回的候选标签数量上限。",
        "slider": {
          "min": 1,
          "max": 100,
          "step": 1
        },
        "default": 20
      },
      "append_original": {
        "type": "bool",
        "description": "追加原文",
        "hint": "翻译后是否在标签后追加用户原始中文描述。",
        "default": false
      }
    }
  },
  "draw_timeout": {
    "type": "int",
    "description": "出图超时(秒)",
    "hint": "等待 ComfyUI 出图的超时时间。",
    "slider": {
      "min": 30,
      "max": 600,
      "step": 10
    },
    "default": 120
  },
  "queue_poll_interval": {
    "type": "int",
    "description": "轮询间隔(秒)",
    "hint": "轮询出图结果的间隔（等待 ComfyUI 生成完成时使用，不再查询队列）。",
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    },
    "default": 2
  },
  "return_queue_position": {
    "type": "bool",
    "description": "提交后发送提示",
    "hint": "提交绘图任务后是否发送可爱提示（无排队时提示正在出图，有排队时提示前面还有几位）。",
    "default": true
  }
}
